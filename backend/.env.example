# ─────────────────────────────────────────────────────────────
#  Copier en `.env` et renseigner. Ne jamais versionner `.env`.
#  Ce fichier-ci est un MODELE : il ne doit contenir aucun secret.
# ─────────────────────────────────────────────────────────────

# Laisser vide en local : PGlite prend le relais, rien a installer.
# En production, Railway fournit cette valeur automatiquement.
DATABASE_URL=

# Obligatoire en production. Generer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Compte administrateur, cree au tout premier demarrage seulement.
ADMIN_EMAIL=admin@dmgp.fr
ADMIN_PASSWORD=
ADMIN_PHONE=0758509931

# Photos des colis. Obligatoire en production : le disque des
# hebergeurs est efface a chaque redeploiement.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Domaines autorises a appeler l'API, separes par des virgules.
# Inutile si l'API et le site sont servis par le meme service.
CORS_ORIGINS=

NODE_ENV=development
PORT=3001
